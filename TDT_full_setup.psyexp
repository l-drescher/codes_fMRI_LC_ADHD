        <Param name="Begin Routine" updates="constant" val="eyetracker.sendMessage(&quot;start_trial bl1&quot;)&amp;#10;eyetracker.sendMessage(&quot;start_phase bl1&quot;)&amp;#10;eyetracker.sendMessage(f&quot;var subject_nr {expInfo['participant']}&quot;)&amp;#10;eyetracker.sendMessage(f&quot;var condition {cond}&quot;)&amp;#10;print(&quot;Baseline interval 1 started.&quot;)" valType="extendedCode"/>
