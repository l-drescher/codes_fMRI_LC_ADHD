        <Param name="stopType" updates="None" val="duration (s)" valType="str"/>
        <Param name="stopVal" updates="constant" val="$isi" valType="code"/>
        <Param name="store" updates="constant" val="last key" valType="str"/>
        <Param name="storeCorrect" updates="constant" val="True" valType="bool"/>
        <Param name="syncScreenRefresh" updates="constant" val="True" valType="bool"/>
      </KeyboardComponent>
      <CodeComponent name="tracker_msgs">
        <Param name="Before Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Before JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin JS Routine" updates="constant" val="if ((currentLoop === firsthalf)) {&amp;#10;    eyetracker.sendMessage(`start_trial ${thisFirsthalf[&quot;trial_index&quot;]}`);&amp;#10;    eyetracker.sendMessage(`start_phase ${thisFirsthalf[&quot;stim&quot;]}`);&amp;#10;    eyetracker.sendMessage(`var trialtype ${thisFirsthalf[&quot;trialtype&quot;]}`);&amp;#10;    console.log(`eyetracking msgs sent: trial ${thisFirsthalf[&quot;trial_index&quot;]} trialtype ${thisFirsthalf[&quot;trialtype&quot;]}`);&amp;#10;    if ((cond === &quot;fast&quot;)) {&amp;#10;        eyetracker.sendMessage(`var validSeq ${thisFirsthalf[&quot;validSeq&quot;]}`);&amp;#10;    }&amp;#10;} else {&amp;#10;    if ((currentLoop === secondhalf)) {&amp;#10;        eyetracker.sendMessage(`start_trial ${thisSecondhalf[&quot;trial_index&quot;]}`);&amp;#10;        eyetracker.sendMessage(`start_phase ${thisSecondhalf[&quot;stim&quot;]}`);&amp;#10;        eyetracker.sendMessage(`var trialtype ${thisSecondhalf[&quot;trialtype&quot;]}`);&amp;#10;        console.log(`eyetracking msgs sent: trial ${thisSecondhalf[&quot;trial_index&quot;]} trialtype ${thisSecondhalf[&quot;trialtype&quot;]}`);&amp;#10;        if ((cond === &quot;fast&quot;)) {&amp;#10;            eyetracker.sendMessage(`var validSeq ${thisSecondhalf[&quot;validSeq&quot;]}`);&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;eyetracker.sendMessage(`var subject_nr ${expInfo[&quot;participant&quot;]}`);&amp;#10;eyetracker.sendMessage(`var condition ${cond}`);&amp;#10;" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="if currentLoop == firsthalf:&amp;#10;    eyetracker.sendMessage(f&quot;start_trial {thisFirsthalf['trial_index']}&quot;)&amp;#10;    eyetracker.sendMessage(f&quot;start_phase {thisFirsthalf['stim']}&quot;)&amp;#10;    eyetracker.sendMessage(f&quot;var trialtype {thisFirsthalf['trialtype']}&quot;)&amp;#10;    print(f&quot;eyetracking msgs sent: trial {thisFirsthalf['trial_index']} trialtype {thisFirsthalf['trialtype']}&quot;)&amp;#10;    if cond == &quot;fast&quot;:&amp;#10;        eyetracker.sendMessage(f&quot;var validSeq {thisFirsthalf['validSeq']}&quot;)&amp;#10;elif currentLoop == secondhalf:&amp;#10;    eyetracker.sendMessage(f&quot;start_trial {thisSecondhalf['trial_index']}&quot;)&amp;#10;    eyetracker.sendMessage(f&quot;start_phase {thisSecondhalf['stim']}&quot;)&amp;#10;    eyetracker.sendMessage(f&quot;var trialtype {thisSecondhalf['trialtype']}&quot;)&amp;#10;    print(f&quot;eyetracking msgs sent: trial {thisSecondhalf['trial_index']} trialtype {thisSecondhalf['trialtype']}&quot;)&amp;#10;    if cond == &quot;fast&quot;:&amp;#10;        eyetracker.sendMessage(f&quot;var validSeq {thisSecondhalf['validSeq']}&quot;)&amp;#10;&amp;#10;eyetracker.sendMessage(f&quot;var subject_nr {expInfo['participant']}&quot;)&amp;#10;eyetracker.sendMessage(f&quot;var condition {cond}&quot;)&amp;#10;" valType="extendedCode"/>
        <Param name="Code Type" updates="None" val="Auto-&gt;JS" valType="str"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each JS Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Routine" updates="constant" val="if ((currentLoop === firsthalf)) {&amp;#10;    eyetracker.sendMessage(`end_phase ${thisFirsthalf[&quot;stim&quot;]}`);&amp;#10;    eyetracker.sendMessage(`end_trial ${thisFirsthalf[&quot;trial_index&quot;]}`);&amp;#10;    console.log(`Stimulus: ${thisFirsthalf[&quot;stim&quot;]}, trialnumber ${thisFirsthalf[&quot;trial_index&quot;]}`);&amp;#10;} else {&amp;#10;    if ((currentLoop === secondhalf)) {&amp;#10;        eyetracker.sendMessage(`end_phase ${thisSecondhalf[&quot;stim&quot;]}`);&amp;#10;        eyetracker.sendMessage(`end_trial ${thisSecondhalf[&quot;trial_index&quot;]}`);&amp;#10;        console.log(`Stimulus: ${thisSecondhalf[&quot;stim&quot;]}, trialnumber ${thisSecondhalf[&quot;trial_index&quot;]}`);&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="if currentLoop == firsthalf:&amp;#10;    eyetracker.sendMessage(f&quot;end_phase {thisFirsthalf['stim']}&quot;)&amp;#10;    eyetracker.sendMessage(f&quot;end_trial {thisFirsthalf['trial_index']}&quot;)&amp;#10;    print(f&quot;Stimulus: {thisFirsthalf['stim']}, trialnumber {thisFirsthalf['trial_index']}&quot;)&amp;#10;elif currentLoop == secondhalf:&amp;#10;    eyetracker.sendMessage(f&quot;end_phase {thisSecondhalf['stim']}&quot;)&amp;#10;    eyetracker.sendMessage(f&quot;end_trial {thisSecondhalf['trial_index']}&quot;)&amp;#10;    print(f&quot;Stimulus: {thisSecondhalf['stim']}, trialnumber {thisSecondhalf['trial_index']}&quot;)" valType="extendedCode"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="name" updates="None" val="tracker_msgs" valType="code"/>
      </CodeComponent>
      <cedrusButtonBoxComponent name="buttonBox_3">
        <Param name="allowedKeys" updates="constant" val="3,3" valType="list"/>
