      </TextComponent>
    </Routine>
    <Routine name="set_condition">
      <CodeComponent name="cond_set_code">
        <Param name="Before Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Before JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Experiment" updates="constant" val="count_conditions = 0" valType="extendedCode"/>
        <Param name="Begin JS Experiment" updates="constant" val="count_conditions = 0;&amp;#10;" valType="extendedCode"/>
        <Param name="Begin JS Routine" updates="constant" val="current_Condition = cond;&amp;#10;" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="# Set the event rate ('fast', 'mod', 'slow')&amp;#10;current_Condition = cond&amp;#10;" valType="extendedCode"/>
        <Param name="Code Type" updates="None" val="Auto-&gt;JS" valType="str"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each JS Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Routine" updates="constant" val="count_conditions += 1;&amp;#10;" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="# Count the conditions&amp;#10;count_conditions += 1" valType="extendedCode"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="name" updates="None" val="cond_set_code" valType="code"/>
