      <Param name="targetLayout" updates="None" val="NINE_POINTS" valType="str"/>
      <Param name="units" updates="None" val="from exp settings" valType="str"/>
    </EyetrackerCalibrationRoutine>
  </Routines>
  <Flow>
    <EyetrackerCalibrationRoutine name="EyeLink_calibration"/>
    <Routine name="start_eyetracker"/>
    <Routine name="instr1"/>
    <LoopInitiator loopType="TrialHandler" name="practice">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('trialtype', 1), ('corrResp', 'None'), ('stim', 'O')]), OrderedDict([('trialtype', 2), ('corrResp', 'space'), ('stim', 'Q')]), OrderedDict([('trialtype', 1), ('corrResp', 'None'), ('stim', 'O')]), OrderedDict([('trialtype', 1), ('corrResp', 'None'), ('stim', 'O')]), OrderedDict([('trialtype', 2), ('corrResp', 'space'), ('stim', 'Q')]), OrderedDict([('trialtype', 2), ('corrResp', 'space'), ('stim', 'Q')]), OrderedDict([('trialtype', 1), ('corrResp', 'None'), ('stim', 'O')]), OrderedDict([('trialtype', 1), ('corrResp', 'None'), ('stim', 'O')]), OrderedDict([('trialtype', 2), ('corrResp', 'space'), ('stim', 'Q')]), OrderedDict([('trialtype', 1), ('corrResp', 'None'), ('stim', 'O')]), OrderedDict([('trialtype', 2), ('corrResp', 'space'), ('stim', 'Q')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="practice.csv" valType="str"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="practice" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="practicetrial"/>
    <Routine name="feedback"/>
    <LoopTerminator name="practice"/>
    <Routine name="instr2"/>
    <Routine name="wait_for_trigger"/>
    <LoopInitiator loopType="TrialHandler" name="conditions">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('cond', 'fast')]), OrderedDict([('cond', 'mod')]), OrderedDict([('cond', 'slow')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="conditions.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="False" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="conditions" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="start_exp"/>
    <Routine name="bl_int1"/>
    <LoopInitiator loopType="TrialHandler" name="firsthalf">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="$cond + 'ER_part_1.csv'" valType="str"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="firsthalf" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="trial"/>
    <LoopTerminator name="firsthalf"/>
    <Routine name="bl_int2"/>
    <LoopInitiator loopType="TrialHandler" name="secondhalf">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="$cond + 'ER_part_2.csv'" valType="str"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="code"/>
      <Param name="name" updates="None" val="secondhalf" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="trial"/>
    <LoopTerminator name="secondhalf"/>
    <Routine name="pause"/>
    <LoopTerminator name="conditions"/>
    <Routine name="stop_eyetracker"/>
    <Routine name="end"/>
  </Flow>
</PsychoPy2experiment>
