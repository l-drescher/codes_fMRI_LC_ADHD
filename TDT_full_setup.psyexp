        <Param name="Begin JS Routine" updates="constant" val="if ((count_pauses === 2)) {&amp;#10;    continueRoutine = false;&amp;#10;}&amp;#10;" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="if count_pauses == 2:&amp;#10;    continueRoutine = False" valType="extendedCode"/>
