        <Param name="Begin Routine" updates="constant" val="# Start eyetracker&amp;#10;eyetracker.setConnectionState(True)&amp;#10;io.clearEvents('all')&amp;#10;eyetracker.setRecordingState(True)" valType="extendedCode"/>
        <Param name="Code Type" updates="None" val="Auto-&gt;JS" valType="str"/>
