    <Routine name="feedback">
      <CodeComponent name="fb_msg_code">
        <Param name="Before Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Before JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Experiment" updates="constant" val="msg='msg not updated'#if this comes up we forgot to update the msg!" valType="extendedCode"/>
        <Param name="Begin JS Experiment" updates="constant" val="msg = &quot;msg not updated&quot;;&amp;#10;" valType="extendedCode"/>
        <Param name="Begin JS Routine" updates="constant" val="if (((trialtype === 2) &amp;&amp; (! buttonBox_2.corr))) {&amp;#10;    msg = &quot;Geen respons. Reageer op de letter Q!&quot;;&amp;#10;    msgColor = &quot;darkorange&quot;;&amp;#10;    console.log(&quot;practice trial: omission error&quot;);&amp;#10;} else {&amp;#10;    if (buttonBox_2.corr) {&amp;#10;        msg = &quot;Correct!&quot;;&amp;#10;        msgColor = &quot;palegreen&quot;;&amp;#10;        console.log(&quot;practice trial: correct&quot;);&amp;#10;    } else {&amp;#10;        msg = &quot;Fout :(&quot;;&amp;#10;        msgColor = &quot;darkorange&quot;;&amp;#10;        console.log(&quot;practice trial: comission error&quot;);&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="if trialtype == 2 and not buttonBox_2.corr:&amp;#10;    msg=&quot;Geen respons. Reageer op de letter Q!&quot;&amp;#10;    msgColor = &quot;darkorange&quot;&amp;#10;    print(&quot;practice trial: omission error&quot;)&amp;#10;elif buttonBox_2.corr: #stored on last run routine&amp;#10;    msg=&quot;Correct!&quot;&amp;#10;    msgColor = &quot;palegreen&quot;&amp;#10;    print(&quot;practice trial: correct&quot;)&amp;#10;else:&amp;#10;    msg=&quot;Fout :(&quot;&amp;#10;    msgColor = &quot;darkorange&quot;&amp;#10;    print(&quot;practice trial: comission error&quot;)" valType="extendedCode"/>
        <Param name="Code Type" updates="None" val="Auto-&gt;JS" valType="str"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each JS Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="name" updates="None" val="fb_msg_code" valType="code"/>
      </CodeComponent>
