    <Routine name="dialogue">
      <CodeComponent name="dialoguebox_code">
        <Param name="Before Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Before JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Experiment" updates="constant" val="# Set the event rate ('fast', 'mod', 'slow')&amp;#10;current_Condition = expInfo['Event rate']&amp;#10;&amp;#10;# Set the condition order (counterbalancing)&amp;#10;counterbalancing = int(expInfo['Condition/scan nr'])&amp;#10;&amp;#10;# True if practice is wanted (first condition).&amp;#10;insert_Practice = counterbalancing == 1&amp;#10;&amp;#10;# True if pause is wanted (first 2 conditions). Suppresses end message.&amp;#10;# If False, end message will be run instead.&amp;#10;insert_Pause = counterbalancing != 3" valType="extendedCode"/>
        <Param name="Begin JS Experiment" updates="constant" val="current_Condition = expInfo[&quot;Event rate&quot;];&amp;#10;counterbalancing = Number.parseInt(expInfo[&quot;Condition/scan nr&quot;]);&amp;#10;insert_Practice = (counterbalancing === 1);&amp;#10;insert_Pause = (counterbalancing !== 3);&amp;#10;" valType="extendedCode"/>
        <Param name="Begin JS Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="Begin Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="Code Type" updates="None" val="Auto-&gt;JS" valType="str"/>
        <Param name="Each Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="Each JS Frame" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="End JS Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="End Routine" updates="constant" val="" valType="extendedCode"/>
        <Param name="disabled" updates="None" val="False" valType="bool"/>
        <Param name="name" updates="None" val="dialoguebox_code" valType="code"/>
      </CodeComponent>
    </Routine>
    <Routine name="start_eyetracker">
      <CodeComponent name="start_eyetracking">
        <Param name="Before Experiment" updates="constant" val="" valType="extendedCode"/>
        <Param name="Before JS Experiment" updates="constant" val="" valType="extendedCode"/>
